{
  "name": "avalanche",
  "productName": "Avalanche",
  "version": "0.1.0",
  "description": "Avalanche: a private, fully offline writing and study workspace.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/ilymezy/Avalanche",
  "author": "Avalanche",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "node tools/run-vitest.mjs run",
    "test:watch": "node tools/run-vitest.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "measure": "node tools/measure-startup.mjs",
    "rebuild": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "docx": "9.10.0",
    "drizzle-orm": "0.45.4",
    "electron-updater": "6.8.9",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pptxgenjs": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.11",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.55.0",
    "markdown-it": "15.0.2",
    "motion": "14.1.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  }
}
